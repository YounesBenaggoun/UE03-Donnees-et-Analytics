{
  "title": "CroakedUp · Santé du service",
  "uid": "croakedup-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Quel est le débit HTTP ?",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(croakedup_http_requests_total[5m]))",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8F9E7A"
          },
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Quel est le taux d'erreur 5xx ?",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "croakedup:http_error_ratio5m",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#C9A646"
          },
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Quel est le temps de réponse P95 ?",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(croakedup_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8F9E7A"
          },
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Combien de parties sont en cours ?",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "croakedup_games_in_progress",
          "legendFormat": "games"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#C9A646"
          },
          "custom": {}
        },
        "overrides": []
      }
    }
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Palette CroakedUp: #8F9E7A #C9A646 #1B1D18 #EFE8D6."
}